# MongoDB connection string. If unreachable, the app falls back to an
# in-memory Mongo instance for local dev — data will not persist across
# restarts unless this points at a real database.
MONGO_URI=mongodb://127.0.0.1:27017/herbchain

# Used to sign/verify JWTs. Use a long, random value in any real environment.
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (jsonwebtoken "expiresIn" format, e.g. 24h, 7d).
JWT_EXPIRES_IN=24h

PORT=3000

# Gemini API key for the AI chatbot (backend-only — never exposed to the
# mobile/web client). Leave unset in dev and the chatbot falls back to a
# deterministic, still-useful summary of retrieved data instead of erroring.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase. The mobile customer app's accounts, profile, health data, orders,
# complaints, and chat history now live in Supabase (see herbchain_app/supabase/
# migrations) instead of MongoDB — Supabase Auth issues the JWTs those users
# present to this backend, verified against the project's public JWKS
# (SUPABASE_URL + "/auth/v1/.well-known/jwks.json" — see
# middleware/supabaseAuthMiddleware.ts), so no separate JWT secret is needed.
# SUPABASE_SECRET_KEY is a service-role-style key (bypasses RLS) used here for
# admin-dashboard reads and any server-side writes into customer_* tables —
# must never be shipped to the mobile/web client, same rule as GEMINI_API_KEY.
# Non-customer roles (Farmer/Collection Center/Manufacturer/etc., used by
# herbchain_web) are unaffected and remain on MongoDB+JWT (JWT_SECRET above).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Razorpay (Standard Checkout, Orders API). Create a free account at
# https://dashboard.razorpay.com, generate a Key ID + Key Secret under
# Settings -> API Keys (use TEST mode keys for development — they start with
# rzp_test_). RAZORPAY_KEY_SECRET is a server-only secret (used to create
# orders and verify payment signatures) and must never be shipped to the
# mobile client — same rule as GEMINI_API_KEY/SUPABASE_SECRET_KEY.
# RAZORPAY_KEY_ID is safe to return to the client (it's the publishable key
# checkout.js needs to open the payment sheet). Also requires running
# herbchain_app/supabase/migrations/0011_customer_orders_razorpay_fields.sql.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
