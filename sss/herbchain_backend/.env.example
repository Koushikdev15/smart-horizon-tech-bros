# MongoDB connection string. If unreachable, the app falls back to an
# in-memory Mongo instance for local dev — data will not persist across
# restarts unless this points at a real database.
MONGO_URI=mongodb://127.0.0.1:27017/herbchain

# Used to sign/verify JWTs. Use a long, random value in any real environment.
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (jsonwebtoken "expiresIn" format, e.g. 24h, 7d).
JWT_EXPIRES_IN=24h

PORT=3000

# Gemini API key for the AI chatbot (backend-only — never exposed to the
# mobile/web client). Leave unset in dev and the chatbot falls back to a
# deterministic, still-useful summary of retrieved data instead of erroring.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase — used ONLY to mirror a copy of each new account into a separate
# Postgres table for the team's own records/analytics. The app's real
# login/session system is still the MongoDB+JWT one above; nothing reads
# from Supabase to authenticate. SUPABASE_SECRET_KEY is a service-role-style
# key (bypasses RLS) and must never be shipped to the mobile/web client —
# backend-only, same rule as GEMINI_API_KEY. Leave unset and mirroring is
# skipped silently (registration still works).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
