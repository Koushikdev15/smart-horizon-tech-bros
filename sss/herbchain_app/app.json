{
  "expo": {
    "name": "AyurTrace+",
    "slug": "ayurtrace-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ayurtrace",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ayurtrace.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14532D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "package": "com.ayurtrace.customer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14532D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AyurTrace+ uses the camera to scan product QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AyurTrace+ uses your photos to scan a QR code from an image you already have."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
