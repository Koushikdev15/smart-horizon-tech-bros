# Supabase — the EXPO_PUBLIC_ prefix inlines these into the app bundle at build
# time, so they are publicly readable by anyone who downloads the app. Only the
# publishable/anon key belongs here. Never put the service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# herbchain_backend (Express/Mongo) base URL. On Android emulator use
# http://10.0.2.2:3000/api/v1; on a physical device use your machine's LAN IP
# instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
