# Supabase — the EXPO_PUBLIC_ prefix inlines these into the app bundle at build
# time, so they are publicly readable by anyone who downloads the app. Only the
# publishable/anon key belongs here. Never put the service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# herbchain_backend (Express/Mongo) base URL. On Android emulator use
# http://10.0.2.2:3000/api/v1; on a physical device use your machine's LAN IP
# instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Google Sign-In (used only by the "forgot password" flow — see app/forgot-password.tsx).
# This is the OAuth 2.0 *Web* client ID from Google Cloud Console (Credentials),
# the same one entered into Supabase's Google provider settings — NOT the
# Android/iOS client ID. Also update app.json's google-signin plugin
# "iosUrlScheme" with your iOS client ID's reversed form for iOS builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
