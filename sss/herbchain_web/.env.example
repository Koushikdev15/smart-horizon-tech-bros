# Supabase project — safe to publish; the anon key is a public client key and
# every table it can reach is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL that product QR codes point at.
#
# Leave unset and codes are built from whatever origin the app is loaded on.
# That is correct in production, but during development it means a code created
# on http://localhost:5173 encodes "localhost" — which no phone can resolve.
#
# Set this to your machine's LAN address while developing (run `vite --host`
# and use the Network URL it prints), or to your real domain in production.
# VITE_PUBLIC_BASE_URL=http://192.168.1.42:5173
